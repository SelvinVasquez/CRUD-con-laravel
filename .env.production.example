# Variables para el servidor en la nube. Se configuran en el panel del
# proveedor; este archivo no se usa directamente.
APP_NAME=CineTeca
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.midominio.com

LOG_LEVEL=error

# Dominio de la interfaz web (la app móvil no necesita CORS)
CORS_ALLOWED_ORIGINS=https://cineteca.midominio.com

# Base de datos de producción
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Claves de Passport: se generan con `php artisan passport:keys` y se pegan
# como variables, o se guardan en storage/ con permisos restringidos.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

{
  "info": {
    "name": "CRUD-con-laravel (Passport)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "pelicula_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Selvin\",\n  \"email\": \"selvin@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data.token) {",
                  "    pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"selvin@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (scope limitado - solo lectura)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data.token) {",
                  "    pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"selvin@example.com\",\n  \"password\": \"password123\",\n  \"scopes\": [\"peliculas.read\"]\n}"
            }
          },
          "description": "Pide un token restringido solo a lectura. A partir de aqui, Crear/Eliminar pelicula deben dar 403 hasta volver a hacer Login sin 'scopes'."
        },
        {
          "name": "Usuario autenticado",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/user"
          },
          "description": "200 OK mientras el token sea valido; si se llama despues de Logout con el mismo token, debe dar 401 Unauthenticated."
        },
        {
          "name": "Token info (scopes del token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/token-info"
          },
          "description": "Muestra el campo 'scopes' del token actual y 'expires' (fecha de expiracion)."
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/logout"
          },
          "description": "Revoca el token actual. Repetir 'Usuario autenticado' despues de esto debe dar 401."
        }
      ]
    },
    {
      "name": "Peliculas",
      "item": [
        {
          "name": "Listar peliculas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/peliculas"
          }
        },
        {
          "name": "Crear pelicula",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data.id) {",
                  "    pm.collectionVariables.set('pelicula_id', data.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/peliculas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Inception\",\n  \"sinopsis\": \"Un ladron de suenos\",\n  \"anio\": 2010,\n  \"genero\": \"Ciencia ficcion\",\n  \"poster_url\": \"https://ejemplo.com/inception.jpg\",\n  \"calificacion\": 8.8,\n  \"favorita\": false,\n  \"vista\": true\n}"
            }
          },
          "description": "Requiere scope peliculas.write. Con un token de solo lectura da 403; con un token de acceso completo da 201 y guarda el id en {{pelicula_id}}."
        },
        {
          "name": "Ver pelicula",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/peliculas/{{pelicula_id}}"
          }
        },
        {
          "name": "Actualizar pelicula",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/peliculas/{{pelicula_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calificacion\": 9.0,\n  \"favorita\": true\n}"
            }
          }
        },
        {
          "name": "Eliminar pelicula",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/peliculas/{{pelicula_id}}"
          },
          "description": "Verificado con tokenCan('peliculas.delete') en el controlador (no middleware). Con un token de solo lectura da 403 sin importar si {{pelicula_id}} existe, porque el scope se valida antes de buscar en la base de datos."
        }
      ]
    }
  ]
}
